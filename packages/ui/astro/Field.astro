---
import "../styles/compositions.css";
import "../styles/controls.css";
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"input"> & {
  id: string;
  label: string;
  as?: "input" | "select" | "textarea";
  rows?: number;
  description?: string;
  error?: string;
};
const {
  id,
  label,
  as = "input",
  description,
  error,
  hidden,
  class: className,
  "aria-describedby": describedBy,
  ...attributes
} = Astro.props;
const descriptionIds =
  [describedBy, description && `${id}-description`, error && `${id}-error`]
    .filter(Boolean)
    .join(" ") || undefined;
const props = {
  ...attributes,
  id,
  class: ["ui-native-control", className].filter(Boolean).join(" "),
  "aria-describedby": descriptionIds,
  "aria-invalid": error ? "true" : attributes["aria-invalid"],
};
---

<div class="ui-field" hidden={hidden} data-invalid={error ? true : undefined}>
  <label class="ui-field-label" for={id}>
    {label}
    {attributes.required && <span aria-hidden="true"> *</span>}
  </label>
  {as === "select" ? (
    <select {...props}>
      <slot />
    </select>
  ) : as === "textarea" ? (
    <textarea {...props}><slot /></textarea>
  ) : (
    <input {...props} />
  )}
  {description && (
    <p class="ui-field-description" id={`${id}-description`}>
      {description}
    </p>
  )}
  <p class="ui-field-error" id={`${id}-error`} role="alert" hidden={!error}>
    {error}
  </p>
</div>
