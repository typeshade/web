---
import "../styles/controls.css";
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"a"> & {
  href: string;
  variant?: "primary" | "secondary";
  size?: "default" | "large";
};
const {
  variant = "secondary",
  size = "default",
  class: className,
  ...attributes
} = Astro.props;
---

<a
  {...attributes}
  class:list={["ui-button", className]}
  data-variant={variant}
  data-size={size}
>
  <slot />
</a>
