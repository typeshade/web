---
import { cn, buttonVariants, type ButtonVariants } from "../recipes";
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"a"> & ButtonVariants & { href: string };
const {
  variant = "secondary",
  size = "default",
  tone = "neutral",
  class: className,
  ...attributes
} = Astro.props;
---

<a
  {...attributes}
  class={cn(buttonVariants({ variant, tone, size }), className)}
  data-tone={tone}
  data-variant={variant}
  data-size={size}
>
  <slot />
</a>
