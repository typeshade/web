---
import { cn, checkboxStyles } from "../recipes";
import type { HTMLAttributes } from "astro/types";
type Props = Omit<HTMLAttributes<"input">, "type"> & { label: string };
const { label, class: className, ...attributes } = Astro.props;
---

<label class={cn(checkboxStyles.root, className)}>
  <input {...attributes} class={checkboxStyles.input} type="checkbox" />
  <span>{label}</span>
</label>
