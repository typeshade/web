---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../recipes/cn";
type Props = HTMLAttributes<"nav"> & { "aria-label": string };
const { class: className, ...attributes } = Astro.props;
---

<nav
  {...attributes}
  class={cn(
    "breadcrumbs flex flex-wrap items-center gap-ui-2 m-0 mb-[22px] text-ui-text-muted text-[11px] [&_a:hover]:text-[var(--ui-link)]",
    className,
  )}
>
  <slot />
</nav>
