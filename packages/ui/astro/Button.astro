---
import { cn, buttonVariants, type ButtonVariants } from "../recipes";
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"button"> & ButtonVariants;
const {
  variant = "secondary",
  tone = "neutral",
  size = "default",
  type = "button",
  class: className,
  ...attributes
} = Astro.props;
---

<button
  {...attributes}
  type={type}
  class={cn(buttonVariants({ variant, tone, size }), className)}
  data-variant={variant}
  data-tone={tone}
  data-size={size}
>
  <slot />
</button>
