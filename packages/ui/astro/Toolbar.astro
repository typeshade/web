---
import { cn, toolbarStyles } from "../recipes";
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"div"> & { label: string };
const { label, class: className, ...attributes } = Astro.props;
---

<div
  {...attributes}
  class={cn(toolbarStyles, className)}
  role="group"
  aria-label={label}
>
  <slot />
</div>
