---
import HomeHero from "@typeshade/site-ui/astro/HomeHero";
import HomeSection from "@typeshade/site-ui/astro/HomeSection";
import StepGrid from "@typeshade/site-ui/astro/StepGrid";
import Eyebrow from "@typeshade/site-ui/astro/Eyebrow";
import TextLink from "@typeshade/site-ui/astro/TextLink";
import "../styles/home.css";
import HomeSurface from "@typeshade/site-ui/astro/HomeSurface";
import LinkButton from "@typeshade/site-ui/astro/LinkButton";
import SiteLayout from "../layouts/SiteLayout.astro";
import { Code } from "astro/components";
const intro =
  "TypeCV is a TypeScript library for computer vision with GPU acceleration. Use it for geometric vision and sparse 3D reconstruction.";
const sample = `import { ShadeDevice, verifyImagePairGpu } from 'typecv/gpu';\n\nconst device = await ShadeDevice.open();\nconst result = await verifyImagePairGpu(device, first, second, matches);\nawait device.dispose();`;
---

<SiteLayout
  locale="en"
  active="home"
  title="Computer vision, powered by TypeShade"
  description={intro}
>
  <HomeSurface class="cv-home">
    <div class="home-content home-main">
      <HomeHero>
        <div class="home-copy">
          <Eyebrow>TYPECV / COMPUTER VISION</Eyebrow>
          <h1>
            Build computer vision tools
            <br />
            with TypeShade and TypeScript.
          </h1>
          <p class="lead">{intro}</p>
          <div class="action-row">
            <LinkButton variant="primary" size="default" href="/lab/">
              Run SfM on a video ↗
            </LinkButton>
            <LinkButton variant="secondary" size="default" href="/docs/">
              Read the guide
            </LinkButton>
          </div>
          <p class="home-note">TypeScript library · TypeShade GPU operators</p>
        </div>
        <div class="home-code">
          <div class="code-frame">
            <div class="panel-heading">
              <span class="live-dot"></span>GPU PAIR VERIFICATION
              <span class="mono">pair.ts</span>
            </div>
            <Code code={sample} lang="ts" />
            <div class="pipeline">
              <span>pixels</span>
              <span>→</span>
              <span>H / E</span>
              <span>→</span>
              <span>R, t</span>
            </div>
          </div>
          <p class="home-note">
            This example verifies image correspondences with a TypeShade WebGPU
            operator.
          </p>
        </div>
      </HomeHero>
      <HomeSection>
        <div class="section-intro">
          <Eyebrow>01 / OPERATORS</Eyebrow>
          <h2>Computer vision foundations</h2>
          <p>
            Use pair verification, pose estimation, triangulation and bundle
            adjustment independently or as part of sparse reconstruction.
          </p>
        </div>
        <StepGrid>
          <a href="/docs/gpu-initialization/">
            <span>01</span>
            <strong>Verify correspondence</strong>
            <small>Radial inversion, H/E consensus and relative pose</small>
          </a>
          <a href="/docs/gpu-geometry/">
            <span>02</span>
            <strong>Recover geometry</strong>
            <small>P3P/PnP RANSAC, triangulation and filtering</small>
          </a>
          <a href="/docs/incremental-sfm/">
            <span>03</span>
            <strong>Refine a scene</strong>
            <small>Schur/PCG bundle adjustment</small>
          </a>
        </StepGrid>
      </HomeSection>
      <HomeSection layout="split">
        <div>
          <Eyebrow>02 / SCOPE</Eyebrow>
          <h2>Build on the current geometry APIs</h2>
          <p>
            TypeCV currently provides CPU reference APIs and TypeShade GPU
            operators for geometric vision and sparse 3D reconstruction. GPU
            FAST/BRIEF feature extraction and matching are available
            experimentally in the SfM lab. Image processing, optical flow and
            learned-vision integration remain planned.
          </p>
          <TextLink href="/docs/gpu-features/">
            Read about GPU features →
          </TextLink>{" "}
          <TextLink href="/docs/roadmap/">Explore the roadmap →</TextLink>
        </div>
        <div class="experiment-summary">
          <Eyebrow>RECORDED EXPERIMENT</Eyebrow>
          <strong>8 / 8 views</strong>
          <span>1,723 sparse landmarks</span>
          <small>Assumed calibration · no ground truth</small>
          <a href="/docs/experiments/pyramid-8134952/">
            Inspect the experiment ↗
          </a>
        </div>
      </HomeSection>
      <HomeSection layout="action">
        <h2>Run a reconstruction on local video</h2>
        <p>
          Choose a local video or prepared frame bundle. The browser samples up
          to eight frames, then runs experimental TypeShade GPU feature matching
          and incremental SfM. The video stays in your browser.
        </p>
        <LinkButton variant="primary" size="default" href="/lab/">
          Open the SfM lab ↗
        </LinkButton>
      </HomeSection>
    </div>
  </HomeSurface>
</SiteLayout>
