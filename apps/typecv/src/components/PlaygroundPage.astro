---
import Eyebrow from "@typeshade/site-ui/astro/Eyebrow";
import "../styles/playground.css";
import "../styles/lab-page.css";
import ReadingSurface from "@typeshade/site-ui/astro/ReadingSurface";
import Field from "@typeshade/site-ui/astro/Field";
import Button from "@typeshade/site-ui/astro/Button";
import SiteLayout from "../layouts/SiteLayout.astro";
const { locale } = Astro.props as { locale: "en" | "ko" };
const ko = locale === "ko";
const intro = ko
  ? "보정된 합성 장면에서 대응점을 생성하고 브라우저에서 TypeCV 이미지 쌍 검증을 실행합니다."
  : "Generate correspondences from a calibrated synthetic scene and run TypeCV image-pair verification in your browser.";
const text = ko
  ? {
      title: "GPU 대응점 검증",
      heading: "두 이미지의 대응점을 검증합니다",
      browser: "생성한 입력과 연산은 브라우저 안에서 처리됩니다.",
      execution: "실행 환경",
      cpu: "CPU 참조 구현 (직접 선택)",
      count: "대응점 수",
      noise: "픽셀 노이즈",
      mismatches: "잘못된 대응점",
      run: "대응점 검증 ↗",
      status: "실행 환경을 선택하고 대응점을 검증하세요.",
      first: "첫 번째 이미지",
      second: "두 번째 이미지",
      legend: "파랑: E 추정에서 채택 · 빨강: 제외 · 회색: 아직 검증하지 않음",
      result: "결과",
      pose: "상대 자세",
      details: "실행 정보",
    }
  : {
      title: "GPU pair verification",
      heading: "Verify correspondences between two images",
      browser: "The generated inputs and computation stay in your browser.",
      execution: "Execution",
      cpu: "CPU reference (explicit)",
      count: "Correspondences",
      noise: "Pixel noise",
      mismatches: "Mismatches",
      run: "Verify pair ↗",
      status: "Choose an execution tier, then verify a pair.",
      first: "First image",
      second: "Second image",
      legend: "Blue: accepted by E · Red: rejected · Gray: not yet verified",
      result: "Result",
      pose: "Relative pose",
      details: "Execution details",
    };
---

<SiteLayout
  locale={locale}
  active="playground"
  title={text.title}
  description={intro}
>
  <ReadingSurface>
    <div class="lab-main playground-page">
      <header class="lab-header">
        <Eyebrow>TYPECV / PLAYGROUND</Eyebrow>
        <h1>{text.heading}</h1>
        <p>
          {intro} {text.browser}
        </p>
      </header>
      <form id="pair-form" class="lab-panel lab-controls">
        <Field
          as="select"
          id="pair-backend"
          name="backend"
          label={text.execution}
        >
          <option value="webgpu">WebGPU</option>
          <option value="cpu">{text.cpu}</option>
        </Field>
        <Field as="select" id="pair-count" name="count" label={text.count}>
          <option>64</option>
          <option selected>128</option>
          <option>256</option>
        </Field>
        <Field as="select" id="pair-noise" name="noise" label={text.noise}>
          <option value="0">0 px</option>
          <option value="0.12" selected>
            0.12 px
          </option>
          <option value="0.5">0.5 px</option>
        </Field>
        <Field
          as="select"
          id="pair-outliers"
          name="outliers"
          label={text.mismatches}
        >
          <option value="0">0%</option>
          <option value="20" selected>
            20%
          </option>
          <option value="30">30%</option>
        </Field>
        <Button variant="primary" id="run" type="submit">
          {text.run}
        </Button>
      </form>
      <p id="status" class="lab-status" role="status" aria-live="polite">
        {text.status}
      </p>
      <div class="pair-canvases">
        <figure>
          <figcaption>{text.first}</figcaption>
          <canvas id="first-image" width="960" height="600"></canvas>
        </figure>
        <figure>
          <figcaption>{text.second}</figcaption>
          <canvas id="second-image" width="960" height="600"></canvas>
        </figure>
      </div>
      <p class="small muted">{text.legend}</p>
      <div id="results" hidden>
        <h2>{text.result}</h2>
        <dl id="summary" class="metrics"></dl>
        <div class="result-grid">
          <div>
            <h3>{text.pose}</h3>
            <pre id="pose"></pre>
          </div>
          <div>
            <h3>{text.details}</h3>
            <pre id="execution"></pre>
          </div>
        </div>
      </div>
      <script type="module" src="/runtime/playground.js"></script>
    </div>
  </ReadingSurface>
</SiteLayout>
