---
import Eyebrow from "@typeshade/site-ui/astro/Eyebrow";
import ReadingSurface from "@typeshade/site-ui/astro/ReadingSurface";
import SiteLayout from "../layouts/SiteLayout.astro";
import HardwareCheck from "./HardwareCheck";
import "../styles/lab-page.css";
import "../styles/sfm-lab.css";

const { locale } = Astro.props as { locale: "en" | "ko" };
const ko = locale === "ko";
const text = ko
  ? {
      title: "하드웨어 점검",
      description:
        "이 기기에서 정해진 GPU 점검을 실행하고 CPU 기준과 비교한 뒤 기록 하나를 보냅니다.",
      heading: "하드웨어 점검",
      body: "TypeCV GPU 커널 다섯 묶음을 작은 고정 입력으로 실행합니다. CLAHE, 평면 깊이 보완, 점군 정리, 장치 손실이 알려진 삼각측량 작업 그룹, 에피폴라 점수 계산의 커널 함수입니다. 각 사례를 이 기기와 이 브라우저의 CPU 계층에서 실행하고 두 결과를 비교합니다. 기기가 고른 에뮬레이션 배정밀도 방식도 기록합니다. 동의하지 않으면 아무것도 전송하지 않습니다.",
      link: "표준 벤치마크는 SfM 실험실에 있습니다. 점검 뒤에 실행하면 그 기록 두 개도 보낼 수 있습니다.",
      lab: "SfM 실험실",
      eyebrow: "TYPECV / SFM LAB / CHECK",
    }
  : {
      title: "Hardware check",
      description:
        "Run fixed GPU checks on this device, compare them with the CPU reference and send one record.",
      heading: "Hardware check",
      body: "The check runs five families of TypeCV's GPU kernels on small fixed inputs: CLAHE, planar depth completion, cloud cleanup, a triangulation workgroup with a known device loss, and the kernel functions of epipolar scoring. Each case runs on this device and on the CPU tier of this browser, and the check compares the two. It also records the emulated-double flavor selected by the device. The check sends nothing without your consent.",
      link: "The SfM lab holds the standard benchmark. Run it after the check to send its two records too.",
      lab: "SfM lab",
      eyebrow: "TYPECV / SFM LAB / CHECK",
    };
---

<SiteLayout
  locale={locale}
  active="lab"
  title={text.title}
  description={text.description}
>
  <ReadingSurface>
    <div class="lab-main">
      <header class="lab-header">
        <Eyebrow>{text.eyebrow}</Eyebrow>
        <h1>{text.heading}</h1>
        <p>{text.body}</p>
        <p>
          {text.link} <a href={ko ? "/ko/lab/" : "/lab/"}>{text.lab}</a>.
        </p>
      </header>
      <HardwareCheck client:load locale={locale} />
    </div>
  </ReadingSurface>
</SiteLayout>
