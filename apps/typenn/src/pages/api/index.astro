---
import Breadcrumbs from "@typeshade/site-ui/astro/Breadcrumbs";
import PageHeading from "@typeshade/site-ui/astro/PageHeading";
import TextLink from "@typeshade/site-ui/astro/TextLink";
import "../../styles/docs.css";
import ReadingSurface from "@typeshade/site-ui/astro/ReadingSurface";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import InlineTypeScript from "@typeshade/site-ui/astro/InlineTypeScript";
const code = `const device = await nn.device({ device: "auto" });
const x = device.tensor([1, 2, 3, 4], { shape: [2, 2] });
const y = x.relu().softmax();
const values = await y.data();

await y.disposeGraph();
await device.dispose();`;
---

<SiteLayout
  locale="en"
  active="api"
  title="TypeNN API reference"
  description="A practical index of TypeNN Device, Tensor, Module, optimizer, and autograd APIs."
>
  <ReadingSurface class="nn-docs">
    <article class="docs-article">
      <Breadcrumbs aria-label="Breadcrumb">
        <a href="/">TypeNN</a>
        <span>/</span>
        <span>API reference</span>
      </Breadcrumbs>
      <PageHeading>
        <Fragment slot="eyebrow">Reference</Fragment>
        <Fragment slot="title">API reference</Fragment>
        <Fragment slot="description">
          An index of the public API used in current examples. See the source
          declarations for exact overloads and options.
        </Fragment>
      </PageHeading>
      <section class="doc-section">
        <h2>Device and Tensor lifecycle</h2>
        <CodeBlock
          title="Create, execute, dispose"
          file="device.ts"
          code={code}
        />
        <ul class="api-list">
          <li>
            <InlineTypeScript code="device(options?)" />
            <span>
              Open a Device using auto, cpu, webgpu, or webgl2 selection.
            </span>
          </li>
          <li>
            <InlineTypeScript code="Device.tensor(values, { shape })" />
            <span>Create an input tensor with a checked shape.</span>
          </li>
          <li>
            <InlineTypeScript code="Tensor.data()" />
            <span>
              Materialize the requested graph result and return host values.
            </span>
          </li>
          <li>
            <InlineTypeScript code="Tensor.disposeGraph(preserve?)" />
            <span>Release graph tensors while retaining selected values.</span>
          </li>
          <li>
            <InlineTypeScript code="Device.dispose()" />
            <span>Wait for pending work and release runtime resources.</span>
          </li>
        </ul>
      </section>
      <section class="doc-section">
        <h2>Tensor operations</h2>
        <div class="api-columns">
          <div>
            <h3>Linear algebra</h3>
            <p>
              <InlineTypeScript code="matmul(other, options?)" />
              <br />
              Rank-2 matrix multiply with transpose options.
            </p>
          </div>
          <div>
            <h3>Elementwise</h3>
            <p>
              <code>add</code>, <code>sub</code>, <code>mul</code>,{" "}
              <code>div</code>, <code>maximum</code>, <code>minimum</code>,{" "}
              <code>pow</code>, and supported activations.
            </p>
          </div>
          <div>
            <h3>Reduction and normalization</h3>
            <p>
              <code>sum</code>, <code>mean</code>, <code>max</code>,{" "}
              <code>min</code>, <code>argMax</code>, <code>softmax</code>, and{" "}
              <code>logSoftmax</code>.
            </p>
          </div>
          <div>
            <h3>Loss and gradients</h3>
            <p>
              <code>softmaxCrossEntropyWithLogits</code>,{" "}
              <InlineTypeScript code="backward()" />, and selected Tensor graph gradient rules.
            </p>
          </div>
        </div>
      </section>
      <section class="doc-section">
        <h2>Modules and optimizers</h2>
        <ul class="api-list">
          <li>
            <code>Module</code>
            <span>
              Register child layers, expose parameters, switch train/eval mode.
            </span>
          </li>
          <li>
            <code>Sequential</code>, <code>Linear</code>, <code>Flatten</code>,{" "}
            <code>ReLU</code>, <code>Dropout</code>
            <span>Core building blocks shown by current examples.</span>
          </li>
          <li>
            <code>optim.SGD</code>, <code>optim.Adam</code>
            <span>
              Compute gradients and update parameters in one device plan. Use{" "}
              <code>alsoRead</code> to read additional Tensors in the same plan.
            </span>
          </li>
          <li>
            <code>CrossEntropyLoss</code>
            <span>
              Loss module for logits and integer class labels in the MNIST example.
            </span>
          </li>
        </ul>
        <p class="fine-print">
          TypeShade's pure-function <code>shadeGrad</code> is separate from
          TypeNN Tensor graph autograd.
        </p>
        <p>
          <TextLink href="https://github.com/typeshade/typenn/tree/main/src">
            Browse source declarations ↗
          </TextLink>
        </p>
      </section>
    </article>
  </ReadingSurface>
</SiteLayout>
