---
import PageHeading from "@typeshade/site-ui/astro/PageHeading";
import TextLink from "@typeshade/site-ui/astro/TextLink";
import "../styles/docs.css";
import ReadingSurface from "@typeshade/site-ui/astro/ReadingSurface";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  locale="en"
  active="guide"
  title="Page not found"
  description="This page does not exist on the TypeNN site."
>
  <ReadingSurface class="nn-docs">
    <article class="docs-article">
      <PageHeading>
        <Fragment slot="eyebrow">404</Fragment>
        <Fragment slot="title">Page not found</Fragment>
        <Fragment slot="description">
          No page exists at this address. Go back to the home page or the guide.
        </Fragment>
      </PageHeading>
      <section class="doc-section">
        <p>
          <TextLink href="/">TypeNN home</TextLink> ·{" "}
          <TextLink href="/guide/">Get started</TextLink> ·{" "}
          <TextLink href="/ko/">한국어</TextLink>
        </p>
      </section>
    </article>
  </ReadingSurface>
</SiteLayout>
