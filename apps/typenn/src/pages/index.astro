---
import HomeHero from "@typeshade/site-ui/astro/HomeHero";
import HomeSection from "@typeshade/site-ui/astro/HomeSection";
import StepGrid from "@typeshade/site-ui/astro/StepGrid";
import Eyebrow from "@typeshade/site-ui/astro/Eyebrow";
import LinkItem from "@typeshade/site-ui/astro/LinkItem";
import LinkList from "@typeshade/site-ui/astro/LinkList";
import TextLink from "@typeshade/site-ui/astro/TextLink";
import HomeSurface from "@typeshade/site-ui/astro/HomeSurface";
import LinkButton from "@typeshade/site-ui/astro/LinkButton";
import SiteLayout from "../layouts/SiteLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";

const quickStart = `import * as nn from "typenn";

const device = await nn.device();
const input = device.tensor([1, 2, 3, 4], { shape: [2, 2] });
const weight = device.tensor([5, 6, 7, 8], { shape: [2, 2] });
const output = input.matmul(weight).relu();

console.log(await output.data());
// Float32Array [19, 22, 43, 50]
await output.disposeGraph();
await device.dispose();`;
---

<SiteLayout
  locale="en"
  active="home"
  title="TypeNN — Neural networks in TypeScript"
  description="Write Tensor operations in TypeScript, run them through the TypeShade compiler and runtime, and try the framework in your browser."
>
  <HomeSurface>
    <div class="home-content">
      <HomeHero>
        <div class="home-copy">
          <Eyebrow>A TypeScript neural network framework</Eyebrow>
          <h1>
            Write the graph.
            <br />
            <span>Compile the work.</span>
          </h1>
          <p class="lead">
            TypeNN gives Tensor and Module code a deferred graph. TypeShade
            compiles its kernels and executes them on CPU and supported GPU
            backends.
          </p>
          <div class="action-row">
            <LinkButton variant="primary" size="default" href="/playground/">
              Try the playground <span aria-hidden="true">→</span>
            </LinkButton>
            <LinkButton variant="secondary" size="default" href="/guide/">
              Read the guide
            </LinkButton>
          </div>
          <p class="release-note">
            Pre-release · source and examples are the current usage reference.
          </p>
        </div>
        <div class="home-code">
          <CodeBlock title="Tensor API" file="example.ts" code={quickStart} />
          <div class="execution-result">
            <span class="result-dot" aria-hidden="true"></span>
            <span>Float32Array</span>
            <code>[19, 22, 43, 50]</code>
            <span class="result-label">Example output</span>
          </div>
        </div>
      </HomeHero>

      <HomeSection aria-labelledby="path-title">
        <div class="section-heading-row">
          <div>
            <Eyebrow>From TypeScript to execution</Eyebrow>
            <h2 id="path-title">Three layers, one visible path.</h2>
          </div>
          <TextLink href="/guide/execution/">
            How execution works <span aria-hidden="true">↗</span>
          </TextLink>
        </div>
        <StepGrid>
          <article>
            <span class="path-index">01</span>
            <h3>Define</h3>
            <p>
              Tensor calls describe shapes and operations. TypeNN records them
              as graph nodes.
            </p>
            <code>tensor.matmul(weight).relu()</code>
          </article>
          <article>
            <span class="path-index">02</span>
            <h3>Lower</h3>
            <p>
              Each node holds a TypeShade kernel function that TypeNN calls on
              resident arrays.
            </p>
            <code>Tensor graph → kernel functions</code>
          </article>
          <article>
            <span class="path-index">03</span>
            <h3>Run</h3>
            <p>
              One fuse scope runs the reachable kernels on the selected
              execution tier.
            </p>
            <code>CPU · WebGPU · WebGL2*</code>
          </article>
        </StepGrid>
        <p class="fine-print">
          * WebGL2 and the CPU tier run the same kernel functions apart. Only
          WebGPU fuses an elementwise chain into one dispatch.
        </p>
      </HomeSection>

      <HomeSection layout="split" aria-labelledby="learn-title">
        <div class="learning-copy">
          <Eyebrow>Explore TypeNN</Eyebrow>
          <h2 id="learn-title">
            Start with a runnable operation. Continue into the system.
          </h2>
          <p>
            Try matrix operations in the browser, then follow the guide into
            graph execution, automatic differentiation, and model training.
          </p>
        </div>
        <LinkList class="learning-links">
          <LinkItem href="/playground/">
            <span>
              <strong>Playground</strong>
              <small>Run real TypeNN operations in this browser.</small>
            </span>
            <b aria-hidden="true">↗</b>
          </LinkItem>
          <LinkItem href="/guide/training/">
            <span>
              <strong>Train a model</strong>
              <small>Build the documented MNIST MLP path.</small>
            </span>
            <b aria-hidden="true">↗</b>
          </LinkItem>
          <LinkItem href="/api/">
            <span>
              <strong>API reference</strong>
              <small>Browse the current Tensor and Module surface.</small>
            </span>
            <b aria-hidden="true">↗</b>
          </LinkItem>
          <LinkItem href="/examples/">
            <span>
              <strong>Examples</strong>
              <small>Open complete source examples and current limits.</small>
            </span>
            <b aria-hidden="true">↗</b>
          </LinkItem>
        </LinkList>
      </HomeSection>

      <HomeSection layout="action" aria-labelledby="status-title">
        <div>
          <Eyebrow>Current implementation</Eyebrow>
          <h2 id="status-title">
            Every op is a kernel function. Training is not tuned yet.
          </h2>
          <p>
            Each <code>data()</code> runs as one TypeShade fuse scope, and{" "}
            <code>device.lastReport</code> shows its plan. SGD and Adam update
            the parameters on the device. Tiled MatMul remains future work.
          </p>
        </div>
        <LinkButton
          variant="secondary"
          size="default"
          href="https://github.com/typeshade/typenn/blob/main/TODO.md"
        >
          Read implementation status <span aria-hidden="true">↗</span>
        </LinkButton>
      </HomeSection>
    </div>
  </HomeSurface>
</SiteLayout>
