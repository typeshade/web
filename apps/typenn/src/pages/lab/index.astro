---
import Breadcrumbs from "@typeshade/site-ui/astro/Breadcrumbs";
import PageHeading from "@typeshade/site-ui/astro/PageHeading";
import ReadingSurface from "@typeshade/site-ui/astro/ReadingSurface";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Lab from "../../components/Lab";
---

<SiteLayout
  locale="en"
  active="lab"
  title="TypeNN Lab"
  description="Train TypeNN models in your browser on full Keras datasets: MNIST, Fashion-MNIST, CIFAR, IMDB, Reuters and California housing."
>
  <ReadingSurface>
    <article class="playground-page lab-page">
      <Breadcrumbs aria-label="Breadcrumb">
        <a href="/">TypeNN</a>
        <span>/</span>
        <span>Lab</span>
      </Breadcrumbs>
      <PageHeading>
        <Fragment slot="eyebrow">Train in your browser</Fragment>
        <Fragment slot="title">Training lab</Fragment>
        <Fragment slot="description">
          Pick a dataset, set a model and its training settings, then train on
          the full training split. The test metric is measured on the full test
          split after each epoch.
        </Fragment>
      </PageHeading>
      <Lab locale="en" client:load />
      <div class="playground-disclosure">
        <p>
          <strong>What this runs:</strong> the TypeNN build shipped with this
          site, on the tier you select. Each step is one optimizer update over
          one batch.
        </p>
        <p>
          Times on this page are wall-clock times in this browser. A software
          renderer (SwiftShader) is not a physical GPU benchmark.
        </p>
      </div>
    </article>
  </ReadingSurface>
</SiteLayout>
