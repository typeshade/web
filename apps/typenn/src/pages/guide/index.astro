---
import Breadcrumbs from "@typeshade/site-ui/astro/Breadcrumbs";
import LinkItem from "@typeshade/site-ui/astro/LinkItem";
import LinkList from "@typeshade/site-ui/astro/LinkList";
import PageHeading from "@typeshade/site-ui/astro/PageHeading";
import TextLink from "@typeshade/site-ui/astro/TextLink";
import "../../styles/docs.css";
import ReadingSurface from "@typeshade/site-ui/astro/ReadingSurface";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
const code = `import * as nn from "typenn";

const device = await nn.device({ device: "auto" });
const a = device.tensor([1, 2, 3, 4], { shape: [2, 2] });
const b = device.tensor([5, 6, 7, 8], { shape: [2, 2] });
const y = a.matmul(b).relu();

const values = await y.data();
console.log(values);
await y.disposeGraph();
await device.dispose();`;
---

<SiteLayout
  locale="en"
  active="start"
  title="Get started with TypeNN"
  description="Create a device, build a Tensor graph, run an operation, and read the result."
>
  <ReadingSurface class="nn-docs">
    <article class="docs-article">
      <Breadcrumbs aria-label="Breadcrumb">
        <a href="/">TypeNN</a>
        <span>/</span>
        <span>Get started</span>
      </Breadcrumbs>
      <PageHeading>
        <Fragment slot="eyebrow">Start here</Fragment>
        <Fragment slot="title">Get started</Fragment>
        <Fragment slot="description">
          Create a device, describe work with Tensor operations, then
          materialize the value you need.
        </Fragment>
      </PageHeading>
      <section class="doc-section" id="install">
        <h2>Project status</h2>
        <p>
          TypeNN is pre-release. The npm package metadata still describes a
          placeholder package, so use the repository source and examples as the
          reference while the release path is prepared.
        </p>
        <p>
          <TextLink href="https://github.com/typeshade/typenn">
            Open the TypeNN repository ↗
          </TextLink>
        </p>
      </section>
      <section class="doc-section" id="first-operation">
        <h2>Run your first operation</h2>
        <p>
          <code>device()</code> selects WebGPU when available and falls back to
          the TypeShade CPU tier. You can request <code>"cpu"</code>,{" "}
          <code>"webgpu"</code>, or <code>"webgl2"</code> explicitly. WebGL2 is
          a constrained path.
        </p>
        <CodeBlock
          title="MatMul followed by ReLU"
          file="first-operation.ts"
          code={code}
        />
      </section>
      <section class="doc-section" id="what-happens">
        <h2>Understand when work runs</h2>
        <p>
          Tensor methods construct a deferred graph. They do not immediately
          read values back to JavaScript. Calling <code>data()</code> executes
          the reachable graph and returns a <code>Float32Array</code> to the
          host.
        </p>
        <div class="note">
          <strong>Keep the graph alive until execution finishes.</strong>
          <span>
            After you consume the result, call <code>disposeGraph()</code> to
            release intermediate tensors. Dispose the Device when its work is
            finished.
          </span>
        </div>
      </section>
      <section class="doc-section">
        <h2>Continue with a guide</h2>
        <LinkList class="next-links">
          <LinkItem href="/guide/execution/">
            <span>
              <strong>Execution model</strong>
              <small>
                Follow a Tensor graph through kernel functions and one fuse
                scope.
              </small>
            </span>
            <b>→</b>
          </LinkItem>
          <LinkItem href="/guide/training/">
            <span>
              <strong>Train a model</strong>
              <small>Build the Module and optimizer path.</small>
            </span>
            <b>→</b>
          </LinkItem>
          <LinkItem href="/playground/">
            <span>
              <strong>Try the Playground</strong>
              <small>Run operations without setting up a project.</small>
            </span>
            <b>→</b>
          </LinkItem>
        </LinkList>
      </section>
    </article>
  </ReadingSurface>
</SiteLayout>
