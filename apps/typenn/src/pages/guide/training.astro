---
import Breadcrumbs from "@typeshade/site-ui/astro/Breadcrumbs";
import PageHeading from "@typeshade/site-ui/astro/PageHeading";
import TextLink from "@typeshade/site-ui/astro/TextLink";
import "../../styles/docs.css";
import ReadingSurface from "@typeshade/site-ui/astro/ReadingSurface";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import InlineTypeScript from "@typeshade/site-ui/astro/InlineTypeScript";
const code = `const model = new SimpleMLP().to(device);
const parameters = model.parameters();
const criterion = new nn.CrossEntropyLoss();
const optimizer = nn.optim.Adam(parameters, { lr: 0.001 });

model.train();
let totalLoss = 0;
let totalSamples = 0;
for await (const batch of new DataLoader(trainData, 64, true)) {
  await optimizer.zeroGrad();
  const images = device.tensor(batch.images, {
    shape: [batch.size, 1, 28, 28],
  });
  const logits = model.forward(images);
  const loss = criterion.forward(logits, batch.labels);
  const batchLoss = (await loss.data())[0];
  if (batchLoss === undefined) throw new Error("CrossEntropyLoss returned no value.");
  await loss.backward();
  await optimizer.step();
  totalLoss += batchLoss * batch.size;
  totalSamples += batch.size;
  await loss.disposeGraph(parameters);
}`;
const modelCode = `export class SimpleMLP extends nn.Module {
  private readonly flatten: nn.Flatten;
  private readonly fc1: nn.Linear;
  private readonly relu: nn.ReLU;
  private readonly dropout: nn.Dropout;
  private readonly fc2: nn.Linear;

  constructor() {
    super();
    this.flatten = this.register("flatten", new nn.Flatten());
    this.fc1 = this.register("fc1", new nn.Linear(784, 128));
    this.relu = this.register("relu", new nn.ReLU());
    this.dropout = this.register("dropout", new nn.Dropout(0.2));
    this.fc2 = this.register("fc2", new nn.Linear(128, 10));
  }

  forward(input: nn.Tensor): nn.Tensor {
    return this.fc2.forward(this.dropout.forward(
      this.relu.forward(this.fc1.forward(this.flatten.forward(input))),
    ));
  }
}`;
---

<SiteLayout
  locale="en"
  active="training"
  title="Train a TypeNN model"
  description="Use Module, Linear, CrossEntropyLoss, Tensor autograd, and Adam in an explicit training loop."
>
  <ReadingSurface class="nn-docs">
    <article class="docs-article">
      <Breadcrumbs aria-label="Breadcrumb">
        <a href="/">TypeNN</a>
        <span>/</span>
        <a href="/guide/">Guides</a>
        <span>/</span>
        <span>Training</span>
      </Breadcrumbs>
      <PageHeading>
        <Fragment slot="eyebrow">Guides</Fragment>
        <Fragment slot="title">Train a model</Fragment>
        <Fragment slot="description">
          The Module API keeps the training loop explicit: clear gradients, run
          forward, backpropagate, update parameters, and release the batch
          graph.
        </Fragment>
      </PageHeading>
      <section class="doc-section">
        <h2>Model definition</h2>
        <p>
          The MNIST example uses a 784 → 128 → 10 MLP with ReLU and Dropout.
          This snippet follows the source model; it omits only the seeded weight
          options.
        </p>
        <CodeBlock
          title="MNIST model"
          file="examples/mnist/model.ts"
          code={modelCode}
        />
      </section>
      <section class="doc-section">
        <h2>Training loop</h2>
        <p>
          The loop below follows the example's batch lifecycle. It explicitly
          reads the batch loss for logging, then runs backward and Adam before
          releasing temporary tensors.
        </p>
        <CodeBlock
          title="Forward, backward, update"
          file="examples/mnist/train.ts"
          code={code}
        />
      </section>
      <section class="doc-section">
        <h2>What happens in a training step</h2>
        <p>
          On every tier, the forward and backward operations run as TypeShade
          kernel functions. When a requested Tensor has no computed array,
          <InlineTypeScript code="data()" /> runs the kernels needed to produce
          it. <InlineTypeScript code="optimizer.step()" /> computes the
          gradients and updates parameters and Adam moments in one device plan.
          It reads
          no gradient back and uploads no parameter. A layer's{" "}
          <code>weight</code> and <code>bias</code> arrays are host copies:{" "}
          <InlineTypeScript code="await model.sync()" /> refreshes them, and
          <InlineTypeScript code="parameter.data()" /> reads one parameter. On
          SwiftShader the device update is not faster than the host loop it
          replaced.
        </p>
        <div class="note">
          <strong>Explicit reads remain reads.</strong>
          <span>
            Calling <InlineTypeScript code="loss.data()" /> or{" "}
            <InlineTypeScript code="parameter.data()" />
            requests a host result. The sample loop above reads back only the
            loss each step.
          </span>
        </div>
      </section>
      <section class="doc-section">
        <h2>Dispose each batch graph</h2>
        <p>
          <InlineTypeScript code="disposeGraph(model.parameters())" /> releases temporary
          tensors while retaining model parameters. Keep the Device alive for
          the training session and dispose it after the final batch and any
          pending work finish.
        </p>
        <p>
          <TextLink href="https://github.com/typeshade/typenn/tree/main/examples/mnist">
            Open the full MNIST example ↗
          </TextLink>
        </p>
      </section>
      <section class="doc-section">
        <h2>Operations covered by this example</h2>
        <p>
          Tensor graph autograd computes gradients for selected operations.
          This guide follows the MNIST Module example; it does not claim support
          for arbitrary user-defined kernels or gradients for every Tensor
          operation.
        </p>
        <nav class="doc-pagination">
          <a href="/guide/execution/">
            <small>Previous</small>
            <strong>Execution model</strong>
          </a>
          <a href="/api/">
            <small>Next</small>
            <strong>API reference</strong>
            <span>→</span>
          </a>
        </nav>
      </section>
    </article>
  </ReadingSurface>
</SiteLayout>
