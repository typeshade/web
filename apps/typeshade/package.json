{
  "name": "typeshade-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "typeshade.dev, the TypeShade website",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-typeplot-assets.mjs --check && node scripts/check-style.mjs && bun scripts/check-copy.ts && node scripts/check-i18n.mjs && bun scripts/check-guide-translations.ts && bun scripts/check-page-samples.ts && bun scripts/check-reference-notes.ts && node scripts/patch-vendor-api.mjs && node scripts/patch-api-categories.mjs && bun scripts/check-api.ts && bun scripts/check-api-translations.ts && rm -rf node_modules/.astro && astro build && node_modules/.bin/pagefind --site dist",
    "preview": "astro preview",
    "check:style": "node scripts/check-style.mjs",
    "check:copy": "bun scripts/check-copy.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:guide": "bun scripts/check-guide-translations.ts",
    "check:samples": "bun scripts/check-page-samples.ts",
    "check:api": "bun scripts/check-api.ts",
    "check:api-ko": "bun scripts/check-api-translations.ts",
    "check:notes": "bun scripts/check-reference-notes.ts",
    "check:notes:lint": "bun scripts/check-reference-notes.ts --lint",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc -p worker/tsconfig.json",
    "format": "prettier --write . && bun scripts/astro-semicolons.ts",
    "format:check": "prettier --check . && bun scripts/astro-semicolons.ts --check",
    "build:icons": "bun scripts/build-icons.ts",
    "build:fonts": "python3 scripts/build-fonts.py",
    "capture:stills": "STILLS_REBASELINE=1 astro build && bun scripts/capture-stills.ts",
    "capture:og": "OG_REBASELINE=1 astro build && bun scripts/capture-og.ts",
    "capture": "bun run build:icons && bun run capture:stills && bun run capture:og",
    "qa:links": "node scripts/check-http-links.mjs dist",
    "qa:seo": "node scripts/check-seo.mjs dist",
    "qa:worker-routes": "node scripts/check-worker-routes.mjs dist",
    "qa:openseo": "bun scripts/openseo-audit.mts dist",
    "check:playground": "node scripts/check-playground.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:function-demos": "node scripts/check-function-demos.mjs",
    "check:mnist": "node scripts/check-mnist-browser.mjs",
    "check:benchmarks": "node scripts/check-benchmarks.mjs",
    "check:benchmark-catalog": "bun scripts/benchmark-catalog.ts --check",
    "check:regression-catalog": "bun scripts/regression-catalog.ts --check",
    "check:operation-lessons": "bun scripts/check-operation-lessons.ts",
    "check:operation-models": "bun scripts/check-operation-models.ts",
    "check:docs-navigation": "bun scripts/check-docs-navigation.ts",
    "check:glsl-precision": "bun scripts/check-glsl-precision.ts",
    "check:standalone-learning": "bun scripts/check-standalone-learning.ts",
    "sync:typeplot-assets": "node scripts/sync-typeplot-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^6.4.8",
    "astro-expressive-code": "^0.44.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.2",
    "temml": "0.14.0",
    "typeplot": "github:typeshade/typeplot#v0.2.1",
    "@typeshade/site-ui": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@webgpu/types": "^0.1.72",
    "fast-xml-parser": "^5.4.1",
    "htmlparser2": "^10.1.0",
    "pagefind": "1.5.2",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "wrangler": "^4.142.0",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
