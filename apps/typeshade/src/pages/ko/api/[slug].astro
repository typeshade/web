---
import { getCollection } from 'astro:content';
import ApiCategoryPage from '../../../components/pages/ApiCategoryPage.astro';
import ApiReferencePage from '../../../components/pages/ApiReferencePage.astro';
import { apiCategories } from '../../../lib/api-nav.ts';

export async function getStaticPaths() {
  const entries = (await getCollection('api')).map((entry) => ({ params: { slug: entry.id }, props: { entry: entry.data } }));
  const categories = apiCategories().map(({ category }) => ({ params: { slug: category.slug }, props: { category: category.slug } }));
  return [...entries, ...categories];
}
const { entry, category } = Astro.props;
---

{category
  ? <ApiCategoryPage locale="ko" slug={category} />
  : <ApiReferencePage locale="ko" entry={entry} path={`/api/${entry.slug}/`} />}
