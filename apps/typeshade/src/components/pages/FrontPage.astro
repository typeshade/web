---
import { Code } from 'astro-expressive-code/components';
import LinkButton from '@typeshade/site-ui/astro/LinkButton';
import TabList from '@typeshade/site-ui/astro/TabList';
import Tab from '@typeshade/site-ui/astro/Tab';
import Base from '../../layouts/Base.astro';
import HomeIntro from '../home/HomeIntro.astro';
import HomeSection from '../home/HomeSection.astro';
import CodeFrame from '../CodeFrame.astro';
import InstallCommand from '../InstallCommand.astro';
import '../CodeTabs.css';
import { copyFor, localePath, type Locale } from '../../i18n/index.ts';
import { examplePath } from '../../lib/example-pages.ts';
import { useTypeshadeHero } from '../../lib/use-typeshade-emit.ts';
import { useTypeshadeSample } from '../../lib/use-typeshade-sample.ts';
import { links } from '../../lib/links.ts';
import { SHADE_STILL_EXAMPLES } from '../../../scripts/artifacts.mjs';
import { checkedShade } from '../../lib/shade-examples.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copyFor(locale);
const f = t.front;
const tileTitles = checkedShade('title', t.examples.shade.titles);
const tiles = (['domain-warp-twin', 'ocean-twin', 'julia-twin'] as const).map((id) => {
  if (!(SHADE_STILL_EXAMPLES as readonly string[]).includes(id))
    throw new Error(`[front] tile '${id}' has no still`);
  return { id, title: tileTitles[id]!, href: localePath(locale, examplePath(id)) };
});
const quickStart = localePath(locale, links.quickStart.href);
const codePanels = [
  { id: 'source', label: f.targets.source, code: useTypeshadeSample, lang: 'ts' },
  { id: 'wgsl', label: f.targets.wgsl, code: useTypeshadeHero.wgsl, lang: 'wgsl' },
  { id: 'glsl', label: f.targets.glsl, code: useTypeshadeHero.glsl, lang: 'glsl' },
];
const textLink =
  'inline-flex items-center gap-2 font-semibold text-text-1 underline decoration-line-2 underline-offset-4 hover:decoration-current';
---

<Base locale={locale} path="/" searchable searchTitle={f.searchTitle}>
  <div class="front-page mx-auto max-w-[1280px] px-5 sm:px-8 lg:px-12">
    <HomeIntro before={f.hero.before} accent={f.hero.accent}>
      <p>{f.lede}</p>
      <Fragment slot="actions">
        <LinkButton variant="primary" size="large" href={quickStart}>
          {f.quickStart}
        </LinkButton>
        <LinkButton size="large" href={localePath(locale, links.playground.href)}>
          {f.playground}
        </LinkButton>
      </Fragment>
      <a slot="more" class={textLink} href={localePath(locale, links.why.href)}>
        {f.why}
        <span aria-hidden="true">→</span>
      </a>
    </HomeIntro>

    <dl class="front-targets grid grid-cols-2 border-y border-line-2 py-6 md:grid-cols-3 md:py-7">
      <div class="col-span-2 border-be border-be-line-1 pbe-5 mbe-5 md:col-span-1 md:border-be-0 md:pbe-0 md:mbe-0">
        <dt class="text-ui text-text-2">{f.source}</dt>
        <dd class="mbs-2 font-mono text-[18px] sm:text-[22px]">TypeScript</dd>
      </div>
      <div class="md:border-s md:border-line-2 md:ps-8">
        <dt class="text-ui text-text-2">WebGPU</dt>
        <dd class="mbs-2 font-mono text-[18px] sm:text-[22px]">WGSL</dd>
      </div>
      <div class="border-s border-line-2 ps-6 md:ps-8">
        <dt class="text-ui text-text-2">WebGL2</dt>
        <dd class="mbs-2 font-mono text-[18px] sm:text-[22px]">GLSL ES 3.00</dd>
      </div>
    </dl>

    <HomeSection id="language" title={f.language.h}>
      <Fragment slot="intro">
        <p>{f.language.p}</p>
        <a class={`${textLink} mbs-5`} href={localePath(locale, links.guide.href)}>
          {f.language.more}
          <span aria-hidden="true">→</span>
        </a>
      </Fragment>
      <dl class="front-language">
        {f.language.rows.map((row) => (
          <div class="border-be border-be-line-1 py-6 first:pt-0 last:border-be-0 last:pb-0">
            <dt class="text-[18px] font-semibold tracking-[-0.015em]">{row.title}</dt>
            <dd>
              <code class="mbs-2 block break-words font-mono text-[12px] leading-6 text-text-2 sm:text-[13px]">
                {row.code}
              </code>
              <p class="mbs-2 max-inline-[60ch] text-[15px] leading-[1.7] text-text-2">
                {row.body}
              </p>
            </dd>
          </div>
        ))}
      </dl>
    </HomeSection>

    <HomeSection id="compiler" title={f.targets.h}>
      <p slot="intro">{f.targets.p}</p>
      <p class="mbe-5 text-[15px] leading-[1.7] text-text-2">{f.targets.count}</p>
      <details class="front-source border-y border-line-2">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[15px] font-semibold">
          {f.targets.summary}
          <svg class="source-chevron h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </summary>
        <div class="pbe-6" data-front-tabs>
          <TabList class="tabs-head flex-wrap" aria-label={f.targets.summary}>
            {codePanels.map((panel, index) => (
              <Tab
                id={`source-tab-${panel.id}`}
                aria-controls={`source-panel-${panel.id}`}
                aria-selected={index === 0}
              >
                {panel.label}
              </Tab>
            ))}
          </TabList>
          {codePanels.map((panel) => (
            <div
              class="tabs-panel mbs-4"
              role="tabpanel"
              id={`source-panel-${panel.id}`}
              aria-labelledby={`source-tab-${panel.id}`}
            >
              <CodeFrame label={panel.label}>
                <Code code={panel.code} lang={panel.lang} locale={locale} wrap />
              </CodeFrame>
            </div>
          ))}
        </div>
      </details>
    </HomeSection>

    <HomeSection id="verification" title={f.oracle.h}>
      <Fragment slot="intro">
        <p>{f.oracle.p}</p>
        <a class={`${textLink} mbs-5`} href={localePath(locale, links.checks.href)}>
          {f.oracle.more}
          <span aria-hidden="true">→</span>
        </a>
      </Fragment>
      <figure>
        <div class="grid grid-cols-2 gap-4">
          {[
            ['gradient', 'WGSL / WebGPU'],
            ['gradient-webgl2', 'GLSL / WebGL2'],
          ].map(([id, label]) => (
            <div>
              <img
                src={`/stills/${id}.webp`}
                alt=""
                width="600"
                height="200"
                loading="lazy"
                decoding="async"
                class="aspect-[5/1] w-full rounded-sm object-cover"
              />
              <p class="mbs-3 font-mono text-[12px] text-text-2">{label}</p>
            </div>
          ))}
        </div>
        <figcaption class="mbs-5 text-ui leading-[1.7] text-text-2">{f.oracle.caption}</figcaption>
      </figure>
    </HomeSection>

    <HomeSection id="examples" title={f.gallery.h}>
      <Fragment slot="intro">
        <p>{f.gallery.p}</p>
        <a class={`${textLink} mbs-5`} href={localePath(locale, links.examples.href)}>
          {f.gallery.all}
          <span aria-hidden="true">→</span>
        </a>
      </Fragment>
      <ul class="front-examples grid gap-3 sm:grid-cols-3 sm:gap-5">
        {tiles.map((tile) => (
          <li class="min-inline-0">
            <a
              class="flex items-center gap-4 py-2 text-text-1 no-underline hover:underline sm:block sm:py-0"
              href={tile.href}
            >
              <img
                class="h-14 w-20 shrink-0 rounded-sm object-cover sm:h-auto sm:aspect-[2/1] sm:w-full"
                src={`/stills/${tile.id}.webp`}
                alt=""
                width="400"
                height="200"
                loading="lazy"
                decoding="async"
              />
              <span class="block text-ui font-semibold sm:mbs-3">{tile.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </HomeSection>

    <HomeSection id="install" title={f.install.h}>
      <Fragment slot="intro">
        <p>{f.install.p}</p>
        <a class={`${textLink} mbs-5`} href={quickStart}>
          {f.install.more}
          <span aria-hidden="true">→</span>
        </a>
      </Fragment>
      <div class="front-install">
        <InstallCommand locale={locale} />
        <p class="mbs-3 text-ui leading-[1.7] text-text-2">{f.install.note}</p>
      </div>
    </HomeSection>
  </div>
</Base>

<style>
  /* Generated code and shared component descendants are styled at their owner. */
  .front-page :global(.expressive-code) {
    margin: 0;
  }
  .front-targets + :global(.home-section) {
    border-block-start: 0;
  }
  .front-source summary::-webkit-details-marker {
    display: none;
  }
  .front-source[open] .source-chevron {
    transform: rotate(180deg);
  }
  .front-source :global(.tabs-head) {
    gap: 16px;
  }
  .front-install :global(.expressive-code + p) {
    margin-block-start: 16px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-2);
  }
  .front-page :global(.home-section:last-child) {
    padding-block-end: 80px;
  }
</style>

<script>
  import '../../scripts/target-tabs.ts';
</script>
