---
import '../Reference.css';
// One section of the TypeScript construct set: the cards for that section's own group and
// nothing else, in runs under an h2 each so the page's outline lists the runs. The index at /guide/language/from-typescript/ says how to read a card and
// links every section. The group's rows come from src/lib/typescript-lowering.ts, which
// compiles one `"use typeshade"` program per row at the pinned commit, and the words come
// from language.mapping.fromTypescript. A row the dictionary has no line for stops the build
// here, and a program the pinned compiler no longer agrees with stops it in the generator.
import Docs, { type Heading } from '../../layouts/Docs.astro';
import ConstructCard from '../ConstructCard.astro';
import Rich from '../Rich.astro';
import { copyFor, localePath, type Locale } from '../../i18n/index.ts';
import { editCopy, links, mappingSet } from '../../lib/links.ts';
import { loweringSections, type LoweringSectionKey } from '../../lib/typescript-lowering.ts';

interface Props {
  locale: Locale;
  /** The generator's key for this section, which is also the key its words are under. */
  section: LoweringSectionKey;
}
const { locale, section } = Astro.props;
const c = copyFor(locale).language.mapping.fromTypescript;
const entry = mappingSet('languageFromTypescript').sections.find((s) => s.key === section);
if (!entry) throw new Error(`[from-typescript] there is no section page for '${section}'`);
const group = loweringSections().find((s) => s.key === section);
if (!group) throw new Error(`[from-typescript] src/lib/typescript-lowering.ts has no '${section}' section`);
for (const row of group.rows) {
  if (!c.rows[row.id]) throw new Error(`[from-typescript] the row '${row.id}' has no line in the dictionary`);
}
// Each card is anchored by its row id in kebab case, `ternaryScalar` as `#ternary-scalar`, and
// each run by its key the same way. A run never takes the anchor of a card on the page.
const anchor = (id: string): string => id.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`);
const words = c.sections[section];
const page = c.pages[section];
// The heading of each run of cards. A run the dictionary has no heading for stops the build.
const headingOf = c.groups as Record<string, string>;
const cardAnchors = new Set(group.rows.map((row) => anchor(row.id)));
for (const g of group.groups) {
  if (!headingOf[g.key]) throw new Error(`[from-typescript] the group '${g.key}' has no heading in the dictionary`);
  if (cardAnchors.has(anchor(g.key))) throw new Error(`[from-typescript] the group '${g.key}' has the anchor of a card`);
}
// The outline lists each run and, under it, each card: a section holds up to fifteen cards, and
// the outline is how a reader finds one without scrolling the page.
const headings: Heading[] = group.groups.flatMap((g) => [
  { depth: 2, slug: anchor(g.key), text: headingOf[g.key]! },
  ...g.rows.map((row) => ({ depth: 3, slug: anchor(row.id), text: c.rows[row.id]!.name.replace(/`/g, '') })),
]);
// The trail names the set this page belongs to. Four of the six section names (Functions,
// Control flow and the like) are also pages of the Language guide, so the h1 alone does not say
// which page a reader is on.
const setLabel = copyFor(locale).docs.labels.mapping.fromTypescript;
const setPath = links.languageFromTypescript.href;
---

<Docs
  locale={locale}
  path={links[entry.link].href}
  title={page.title}
  description={page.description}
  editHref={editCopy(locale, 'language')}
  headings={headings}
  breadcrumbs={[
    { name: setLabel, href: setPath },
    { name: words.h, href: links[entry.link].href },
  ]}
>
  <nav class="api-crumbs" aria-label={c.crumbs} lang={locale}>
    <a href={localePath(locale, setPath)}>{setLabel}</a>
  </nav>
  <h1>{words.h}</h1>
  <p><Rich text={words.p} locale={locale} /></p>
  {group.groups.map((run) => (
    <>
      <h2 id={anchor(run.key)}>{headingOf[run.key]}</h2>
      <ul class="construct-cards grid grid-cols-1 gap-4">
        {run.rows.map((row) => (
          <ConstructCard
            locale={locale}
            id={anchor(row.id)}
            name={c.rows[row.id]!.name}
            becomes={c.rows[row.id]!.p}
            ts={row.ts}
            tsTitle={c.paneTs}
            emitTitle={c.paneWgsl}
            wgsl={row.wgsl}
            glsl={row.glsl}
            glslNote={row.glslNote}
            diagnostic={row.diagnostic}
            refusedLabel={c.refused}
            diagnosticTitle={c.paneDiagnostic}
            tabs={{ label: c.tabsLabel, wgsl: c.tabWgsl, glsl: c.tabGlsl, wgslRegion: `${c.paneWgsl}, ${c.rows[row.id]!.name.replace(/`/g, '')}`, glslRegion: `${c.paneGlsl}, ${c.rows[row.id]!.name.replace(/`/g, '')}`, glslTitle: c.paneGlsl, glslNone: c.glslNone }}
          />
        ))}
      </ul>
    </>
  ))}
</Docs>

<style>
  /* One card per row. A card holds two code panes, and they sit side by side only where each
     pane keeps a line of code readable; the card decides that for itself (ConstructCard.astro).
     The list takes the whole column and outranks `.doc ul` and the column's measure on its blocks. */
  .construct-cards { max-inline-size: none; margin: 24px 0 0; padding: 0; list-style: none }
</style>
