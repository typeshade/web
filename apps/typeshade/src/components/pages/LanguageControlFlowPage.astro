---
// Language guide: Control flow. Content lives in language.topics.controlFlow (src/i18n/en.ts,
// src/i18n/ko.ts); the code samples are not copy, so they stay here.
import Docs from '../../layouts/Docs.astro';
import TypeShadeCode from '../TypeShadeCode.astro';
import Rich from '../Rich.astro';
import { copyFor, localePath, type Locale } from '../../i18n/index.ts';
import { editCopy, links } from '../../lib/links.ts';
import { kernelLoopWarnings } from '../../lib/kernel-loops.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = copyFor(locale).language.topics.controlFlow;
const h2 = (slug: string, text: string) => ({ depth: 2, slug, text });
const h3 = (slug: string, text: string) => ({ depth: 3, slug, text });
const headings = [
  h2('ts', content.ts),
  h2('branch', content.branch), h3('if', content.ifStatement), h3('conditional', content.conditional), h3('costly-arm', content.costlyArm),
  h2('loop', content.loop), h3('loop-statements', content.loopStatements), h3('loop-methods', content.loopMethods),
  h2('kernel', content.kernel), h3('kernel-function', content.kernelFunction), h3('kernel-proof', content.kernelProof), h3('workgroup-size', content.workgroupSize), h3('last-workgroup', content.lastWorkgroup), h3('kernel-methods', content.kernelMethods), h3('kernel-warn', content.kernelWarn), h3('kernel-layout', content.kernelLayout),
  h2('collect', content.collect), h3('push', content.push), h3('push-capacity', content.pushCapacity), h3('collections', content.collections),
  h2('fuse', content.fuse), h3('fuse-calls', content.fuseCalls), h3('fuse-report', content.fuseReport), h3('fuse-indirect', content.fuseIndirect), h3('fuse-constants', content.fuseConstants), h3('device', content.device), h3('chunk', content.chunk), h3('modules', content.modules),
  h2('boundary', content.boundary),
];
// TS8070's warnings as the pinned compiler writes them (surface §65), in both languages.
const warnings = kernelLoopWarnings();
---

<Docs locale={locale} path={links.languageControlFlow.href} title={content.title} description={content.description} headings={headings} editHref={editCopy(locale, 'language')}>
  <h1>{content.h1}</h1><p>{content.intro}</p>
  <h2 id="ts">{content.ts}</h2><p>{content.tsP}</p>
  <h2 id="branch">{content.branch}</h2><p><Rich text={content.branchIndexP} locale={locale} /></p>
  <h3 id="if">{content.ifStatement}</h3><p>{content.branchP}</p>
  <TypeShadeCode code={`@compute([64, 1, 1])\nexport function paint(@builtin("global_invocation_id") gid: vec3u) {\n  if (camera.pos.x > 0) {\n    pixels[gid.x] = 1\n  } else {\n    pixels[gid.x] = 0\n  }\n}`} />
  <h3 id="conditional">{content.conditional}</h3><p><Rich text={content.conditionalP} locale={locale} /></p>
  <h3 id="costly-arm">{content.costlyArm}</h3><p><Rich text={content.costlyArmP} locale={locale} /></p>
  <h2 id="loop">{content.loop}</h2><p>{content.loopIndexP}</p>
  <h3 id="loop-statements">{content.loopStatements}</h3><p>{content.loopStatementsP}</p>
  <TypeShadeCode code={`for (let i = 0; i < 4; i++) {\n  pixels[i] = pixels[i] + camera.pos.x\n}`} />
  <h3 id="loop-methods">{content.loopMethods}</h3><p>{content.loopMethodsP}</p>
  <h2 id="kernel">{content.kernel}</h2><p>{content.kernelIndexP}</p>
  <h3 id="kernel-function">{content.kernelFunction}</h3><p><Rich text={content.kernelFunctionP} locale={locale} /></p>
  <p><Rich text={content.kernelCallP} locale={locale} /></p>
  <TypeShadeCode code={`export function render(k: vec4, size: u32, out: array<f32>) {\n  for (let i: u32 = 0; i < size * size; i++) {\n    const p = vec2(f32(i % size), f32(i / size)) / f32(size)\n    out[i] = k.x * sin(p.x * k.y) + k.z * cos(p.y * k.w)\n  }\n}`} />
  <h3 id="kernel-proof">{content.kernelProof}</h3><p><Rich text={content.kernelShapeP} locale={locale} /></p>
  <p><Rich text={content.kernelWritesP} locale={locale} /></p>
  <p><Rich text={content.kernelReadsP} locale={locale} /></p>
  <h3 id="workgroup-size">{content.workgroupSize}</h3><p><Rich text={content.workgroupSizeP} locale={locale} /></p>
  <h3 id="last-workgroup">{content.lastWorkgroup}</h3><p>{content.lastWorkgroupP}</p>
  <p>{content.lastWorkgroupReadP}</p>
  <h3 id="kernel-methods">{content.kernelMethods}</h3><p><Rich text={content.methodsP} locale={locale} /></p>
  <TypeShadeCode code={`export function stats(xs: array<f32>, out: array<f32>): f32 {\n  xs.forEach((x, i) => {\n    out[i] = x * 2.\n  })\n  const s = xs.reduce((a, x) => a + x * x, 0.)\n  return sqrt(s)\n}`} />
  <p><Rich text={content.methodsOrderP} locale={locale} /></p>
  <h3 id="kernel-warn">{content.kernelWarn}</h3><p><Rich text={content.kernelWarnP} locale={locale} /></p>
  <table>
    <thead><tr><th>{content.kernelRule}</th><th>{content.kernelWarning}</th></tr></thead>
    <tbody>{warnings.map((w) => <tr><td data-label={content.kernelRule}><code>{w.rule}</code></td><td data-label={content.kernelWarning}><code lang="en">{w.warning}</code></td></tr>)}</tbody>
  </table>
  <h3 id="kernel-layout">{content.kernelLayout}</h3><p><Rich text={content.kernelLayoutP} locale={locale} /></p>
  <h2 id="collect">{content.collect}</h2><p><Rich text={content.collectIndexP} locale={locale} /></p>
  <h3 id="push">{content.push}</h3><p><Rich text={content.pushP} locale={locale} /></p>
  <TypeShadeCode code={`export function strong(xs: array<f32>, t: f32, out: array<u32>): u32 {\n  for (let i: u32 = 0; i < xs.length; i++) {\n    if (xs[i] > t) {\n      out.push(i)\n    }\n  }\n  return out.length\n}`} />
  <h3 id="push-capacity">{content.pushCapacity}</h3><p><Rich text={content.pushHostP} locale={locale} /></p>
  <TypeShadeCode code={`const out = new Uint32Array(1024) // the capacity\nconst n = await strong(xs, 0.5, out) // out holds the first indices, in ascending order`} title="host.ts" />
  <h3 id="collections">{content.collections}</h3><p><Rich text={content.collectionsP} locale={locale} /></p>
  <TypeShadeCode code={`export function labels(pixels: array<u32>, seen: Set<u32>): u32 {\n  for (let i: u32 = 0; i < pixels.length; i++) {\n    if (pixels[i] !== 0) {\n      seen.add(pixels[i])\n    }\n  }\n  return seen.size\n}`} />
  <p><Rich text={content.collectionsReadP} locale={locale} /></p>
  <h2 id="fuse">{content.fuse}</h2><p>{content.fuseIndexP}</p>
  <h3 id="fuse-calls">{content.fuseCalls}</h3><p><Rich text={content.fuseP} locale={locale} /></p>
  <h3 id="fuse-report">{content.fuseReport}</h3><p><Rich text={content.fuseReportP} locale={locale} /></p>
  <h3 id="fuse-indirect">{content.fuseIndirect}</h3><p><Rich text={content.fuseIndirectP} locale={locale} /></p>
  <h3 id="fuse-constants">{content.fuseConstants}</h3><p><Rich text={content.fuseOverrideP} locale={locale} /></p>
  <h3 id="device">{content.device}</h3><p><Rich text={content.deviceP} locale={locale} /></p>
  <TypeShadeCode code={`import { createDevice } from 'typeshade/runtime'\nimport 'typeshade/fuse'\n\nconst dev = await createDevice({ prefer: ['webgpu', 'cpu'] })\nconst a = dev.array(new Float32Array(n))\nconst out = dev.array(n, 'f32')\nawait dev.fuse(() => {\n  relu(out, a)\n})\ndev.release(a) // the next array(n, 'f32') takes it from the pool\nconst values = await out.read()\nawait dev.dispose()`} title="host.ts" />
  <h3 id="chunk">{content.chunk}</h3><p><Rich text={content.chunkP} locale={locale} /></p>
  <h3 id="modules">{content.modules}</h3><p><Rich text={content.modulesP} locale={locale} /></p>
  <h2 id="boundary">{content.boundary}</h2><ul>{content.boundaryItems.map((item) => <li><Rich text={item} locale={locale} /></li>)}</ul>
  <p><a href={localePath(locale, links.languageGpuTypes.href)}>{content.next}</a></p>
</Docs>
