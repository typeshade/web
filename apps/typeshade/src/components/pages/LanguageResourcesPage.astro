---
// Language guide: Resources. Content lives in language.topics.resources (src/i18n/en.ts,
// src/i18n/ko.ts); the code samples and the fixed Declaration/Space/Access table are not
// copy, so they stay here.
import Docs from '../../layouts/Docs.astro';
import TypeShadeCode from '../TypeShadeCode.astro';
import Rich from '../Rich.astro';
import { copyFor, localePath, type Locale } from '../../i18n/index.ts';
import { editCopy, links } from '../../lib/links.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = copyFor(locale).language.topics.resources;
const headings = [
  ['mapping', content.mapping], ['decl', content.decl], ['access', content.access], ['slots', content.slots], ['workgroup', content.workgroup], ['invalid', content.invalid],
].map(([slug, text]) => ({ depth: 2, slug, text: text.replace(/`/g, '') }));
---

<Docs locale={locale} path={links.languageResources.href} title={content.title} description={content.description} headings={headings} editHref={editCopy(locale, 'language')}>
  <h1>{content.h1}</h1><p><Rich text={content.intro} locale={locale} /></p>
  <h2 id="mapping">{content.mapping}</h2><p><Rich text={content.mappingP} locale={locale} /></p>
  <TypeShadeCode code={`declare const camera: uniform<Camera>\ndeclare const pixels: storage<array<f32>, "read_write">`} />
  <h2 id="decl"><Rich text={content.decl} locale={locale} /></h2><p>{content.declP}</p>
  <h2 id="access">{content.access}</h2><p><Rich text={content.accessP} locale={locale} /></p>
  <table><thead><tr><th>Declaration</th><th>Space</th><th>Access</th></tr></thead><tbody><tr><td data-label="Declaration"><code>declare const x: uniform&lt;T&gt;</code></td><td data-label="Space">uniform</td><td data-label="Access">read</td></tr><tr><td data-label="Declaration"><code>declare const x: storage&lt;T&gt;</code></td><td data-label="Space">storage</td><td data-label="Access">read</td></tr><tr><td data-label="Declaration"><code>declare const x: storage&lt;T, "read_write"&gt;</code></td><td data-label="Space">storage</td><td data-label="Access">read_write</td></tr></tbody></table>
  <h2 id="slots">{content.slots}</h2><p>{content.slotsP}</p>
  <h2 id="workgroup">{content.workgroup}</h2><p><Rich text={content.workgroupP} locale={locale} /></p>
  <TypeShadeCode code={`const WG_SIZE: override<u32> = 64;\nlet tile: workgroup<array<f32, WG_SIZE>>;`} />
  <h2 id="invalid">{content.invalid}</h2><ul>{content.invalidItems.map((item) => <li><Rich text={item} locale={locale} /></li>)}</ul>
  <p><a href={localePath(locale, links.languageStages.href)}>{content.next}</a></p>
</Docs>
