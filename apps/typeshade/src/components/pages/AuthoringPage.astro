---
// One section of the compiler's internal guide. The English body is the compiler's AUTHORING.md at the
// pinned commit. Another language shows its own translation from content/guide/<locale>/ when
// the section has one, and the English body under a note that says so when it does not. The
// title, the description and the chrome come from the language's guide.sections map. The
// section's own heading is dropped from the body, because the page's h1 carries it.
import { getEntry, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import Rich from '../Rich.astro';
import { assertGuideSections, copyFor, guideSection, localePath, localeSettings, type Locale } from '../../i18n/index.ts';
import { editGuide, editGuideTranslation, links } from '../../lib/links.ts';
import { facts } from '../../lib/examples.ts';

interface Props {
  locale: Locale;
  /** The entry's id. 'overview' is the internal guide's own page. */
  section: string;
}
const { locale, section } = Astro.props;
const t = copyFor(locale);
const g = t.guide;
const entry = await getEntry('guide', section);
if (!entry) throw new Error(`[guide] AUTHORING.md has no section '${section}'`);
const guideCollection = localeSettings[locale].guideCollection;
const translated = guideCollection ? await getEntry(guideCollection, section) : undefined;
const source = translated ?? entry;
const { Content, headings } = await render(source);
// The cross-links the remark plugins add name the English API and language reference, error
// and rule pages; a Korean page keeps the reader in Korean chrome by prefixing them in the
// rendered HTML. Every reference page has a page in each language.
const localized = locale === 'en' ? null : (source.rendered?.html ?? '').replace(/href="\/(api|reference)\//g, `href="/${locale}/$1/`);

// Every section is named and described in every language, and no language names one the
// guide has dropped. A build stops here with the id that is missing or stale.
assertGuideSections();
const overview = entry.id === 'overview';
const named = overview ? undefined : guideSection(locale, entry.id);
const title = named?.title ?? '';
const note = translated || locale === 'en' ? g.note : g.noteUntranslated;
// Guide › Compiler internals › section, keeping the compiler reference visibly below the language guide.
const breadcrumbs = [
  { name: t.nav.guide, href: links.motivation.href },
  { name: t.docs.labels.internals, href: links.internals.href },
  ...(overview ? [] : [{ name: title, href: `/guide/internals/${entry.id}/` }]),
];
// The sidebar's flat order puts the last API category before the overview, so previous on the
// overview names the reference's own index instead; the sections keep the sidebar's walk.
const previous = overview ? { label: t.docs.api.h1, href: localePath(locale, links.api.href) } : undefined;
---

<Docs
  locale={locale}
  path={overview ? links.internals.href : `/guide/internals/${entry.id}/`}
  title={overview ? g.title : g.sectionTitle(title)}
  description={overview ? g.description : named!.description}
  headings={headings}
  editHref={translated ? editGuideTranslation(locale, entry.id) : editGuide(entry.data.sourceLine)}
  bodyLang={translated ? locale : 'en'}
  breadcrumbs={breadcrumbs}
  previous={previous}
  dateModified={facts.pinnedDate}
>
  <p class="guide-note" lang={locale} data-pagefind-ignore><Rich text={note} locale={locale} /></p>
  {!overview && <h1>{title}</h1>}
  {section === 'glsl-float-precision' && <aside class="guide-note" lang={locale}><p><strong>{t.concepts.glslPrecision.correctionH}</strong></p><p><Rich text={t.concepts.glslPrecision.correction} locale={locale} /></p></aside>}
  {localized === null ? <Content /> : <Fragment set:html={localized} />}
</Docs>
