---
// One compiled shader in a framed figure. The shader is emitted at build time
// (src/lib/hero-shader.ts) and inlined as JSON; the browser runs src/lib/shader-runtime.ts.
// A still image captured at build time sits under the canvas, so a browser with no GPU API,
// a crawler or a social preview still sees the rendered shader.
import { heroShader, heroPayload } from '../lib/hero-shader.ts';
import type { StateStrings } from '../lib/shader-runtime.ts';
import { facts } from '../lib/examples.ts';
import { copyFor, type Locale } from '../i18n/index.ts';

/** Caption text by what drew the frame. `neutral` is what the server renders. */
export interface CanvasText {
  readonly neutral: string;
  readonly webgpu: string;
  readonly webgl2: string;
  readonly none: string;
  readonly reduced?: string;
}

interface Props {
  locale: Locale;
  example: string;
  caption: CanvasText;
  /** The frame's shape. `auto` hands the box to the page, for a mount that fills a cell it
   *  shares with something else (the example pages' two-pane card). */
  aspect: '3/1' | '2/1' | '16/9' | '3/2' | 'auto';
  /** Draw one frame at a fixed clock, then stop. */
  still?: boolean;
  /** Skip the WebGPU probe and draw on WebGL2. */
  forceWebGl2?: boolean;
  /** Divide the frame in two, for an example whose halves are captioned separately. */
  split?: boolean;
  /** Load this figure's still with the first paint. Set on the figure above the fold. */
  eager?: boolean;
  /** Which still sits under the canvas; defaults to the example id. A second mount of the
   *  same example forced onto another backend names its own still. */
  stillId?: string;
  /** The page places the caption and owns the scope: no `<figcaption>` is written here, and
   *  the mount looks for `[data-shader-caption]` inside the page's own `[data-shader-scope]`.
   *  For a canvas that fills a pane of its own, with nothing written inside the pane. */
  externalCaption?: boolean;
  class?: string;
}

const {
  locale,
  example,
  caption,
  aspect,
  still = false,
  forceWebGl2 = false,
  split = false,
  stillId,
  eager = false,
  externalCaption = false,
  class: className,
} = Astro.props;
const data = heroShader(example);

const expand = (t: CanvasText): StateStrings => ({
  webgpu: t.webgpu,
  webgl2: t.webgl2,
  none: t.none,
  'still-webgpu': t.reduced ?? t.webgpu,
  'still-webgl2': t.reduced ?? t.webgl2,
});

const aria: StateStrings = copyFor(locale).canvas.aria(data.title);
const labels = { caption: expand(caption), aria };

// A split figure's halves are named in its caption, so the example has to declare them.
if (split && !facts.splitLabels) throw new Error(`[ShaderCanvas] '${example}' declares no splitLabels`);

// One payload per example per page.
const store = Astro.locals as Record<string, unknown>;
const emitted = (store.__shaderPayloads ??= new Set<string>()) as Set<string>;
const payloadId = `shader-payload-${data.id}`;
const firstOfExample = !emitted.has(data.id);
emitted.add(data.id);
---

<figure class:list={['figure', className]} data-shader-scope={externalCaption ? undefined : ''}>
  <div
    class="figure-frame"
    style={`aspect-ratio: ${aspect}`}
    data-shader-canvas
    data-example={data.id}
    data-payload={payloadId}
    data-still={still ? '1' : undefined}
    data-force-webgl2={forceWebGl2 ? '1' : undefined}
    data-labels={JSON.stringify(labels)}
  >
    <img
      src={`/stills/${stillId ?? data.id}.webp`}
      alt={aria.none}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
    <canvas role="img" aria-label={aria.none} data-backend="none"></canvas>
    {split && <span class="figure-split" aria-hidden="true"></span>}
  </div>
  {!externalCaption && <figcaption class="figure-caption" data-shader-caption>{caption.neutral}</figcaption>}
  {firstOfExample && <script type="application/json" id={payloadId} set:html={heroPayload(data.id)} is:inline />}
</figure>

<script>
  import { mountShader, type ShaderData, type StateStrings } from '../lib/shader-runtime.ts'

  interface MountLabelData {
    caption: StateStrings
    aria: StateStrings
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-shader-canvas]')) {
    if (root.dataset.mounted) continue
    root.dataset.mounted = '1'
    const canvas = root.querySelector('canvas')
    const raw = document.getElementById(root.dataset.payload ?? '')?.textContent
    if (!canvas || !raw) continue
    let data: ShaderData
    let labels: MountLabelData
    try {
      data = JSON.parse(raw) as ShaderData
      labels = JSON.parse(root.dataset.labels ?? '') as MountLabelData
    } catch {
      continue
    }
    const scope = root.closest<HTMLElement>('[data-shader-scope]')
    void mountShader(canvas, data, {
      still: root.dataset.still === '1',
      forceWebGl2: root.dataset.forceWebgl2 === '1',
      labels: {
        caption: { el: scope?.querySelector<HTMLElement>('[data-shader-caption]') ?? null, text: labels.caption },
        ariaLabel: labels.aria,
      },
    }).catch(() => {})
  }
</script>
