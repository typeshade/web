---
// The walkthrough presents slices of the exact shader that the live lab compiles.
// The build fails if its kernel definitions change without the explanation being updated.
import { readFileSync } from 'node:fs';
import path from 'node:path';
import TypeShadeCode from './TypeShadeCode.astro';
import { copyFor, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = copyFor(locale).mnist.walkthrough;
const shaderPath = 'vendor/shader-dsl/journeys/mnist/softmax.shade.ts';
const shader = readFileSync(path.resolve(shaderPath), 'utf8');
const matches = [...shader.matchAll(/^@compute\(\[\d+\]\)\s*\nexport function (\w+)\(/gm)];
const expected = ['forward', 'objective', 'reduce', 'backward', 'update', 'predict'];
const actual = matches.map((m) => m[1]);
if (actual.join('|') !== expected.join('|'))
  throw new Error('[mnist-guide] Shader entries changed; update the guided explanation: ' + actual.join(', '));
const setup = shader.slice(0, matches[0].index).trim();
if (!setup.startsWith('"use typeshade";') || !setup.includes('function stableProbability('))
  throw new Error('[mnist-guide] Missing directive, resources, or shared softmax helper');
const kernelCode = Object.fromEntries(
  matches.map((m, index) => [
    m[1],
    shader.slice(m.index, matches[index + 1]?.index ?? shader.length).trim(),
  ]),
);
const order = ['setup', 'forward', 'objective', 'backward', 'update', 'reduce', 'predict'] as const;
const examples = order.map((name, index) => ({
  name,
  title: c.steps[index]?.title,
  purpose: c.steps[index]?.purpose,
  explanation: c.steps[index]?.explanation,
  code: name === 'setup' ? setup : kernelCode[name],
}));
if (examples.length !== c.steps.length || examples.some((e) => !e.code || !e.title || !e.purpose || !e.explanation))
  throw new Error('[mnist-guide] Walkthrough copy or shader source is incomplete');
const host = readFileSync(path.resolve('vendor/shader-dsl/journeys/mnist/browser-session.ts'), 'utf8');
function hostMethod(start: string, end: string): string {
  const a = host.indexOf(start);
  const b = host.indexOf(end, a + start.length);
  if (a < 0 || b < 0)
    throw new Error('[mnist-guide] Shared browser host method changed: ' + start);
  return host.slice(a, b).trim();
}
const hostTraining = hostMethod('    trainBatch(pixels, labels, rate) {', '    evaluateBatch(pixels, labels) {');
const hostPrediction = hostMethod('    predict(pixels) {', '    readModel() {');
if (!hostTraining.includes("'forward', 'objective', 'backward', 'update'") ||
    !hostPrediction.includes("dispatch('predict'"))
  throw new Error('[mnist-guide] Host execution stages no longer match the explanation');
---
<div class="mnist-walkthrough" data-mnist-walkthrough>
  <p>{c.intro}</p>
  <div class="mnist-flow" aria-label={c.flowTitle}>
    <p><strong>{c.trainFlow}</strong> <code>forward → objective → backward → update</code></p>
    <p><strong>{c.testFlow}</strong> <code>forward → objective → reduce</code></p>
    <p><strong>{c.predictFlow}</strong> <code>forward → predict</code></p>
  </div>
  <p>{c.readGuide}</p>
  {examples.map((example, index) => (
    <article class="mnist-step" data-mnist-code-step={example.name}>
      <h3>{index + 1}. {example.title}</h3>
      <p>{example.purpose}</p>
      <TypeShadeCode lang="ts" code={example.code} title={example.name === 'setup' ? 'softmax.shade.ts — resources' : 'softmax.shade.ts — ' + example.name} />
      <p class="mnist-step-explanation">{example.explanation}</p>
    </article>
  ))}
  <section class="mnist-host" aria-labelledby="mnist-host-explained">
    <h3 id="mnist-host-explained">{c.hostTitle}</h3>
    <p>{c.hostIntro}</p>
    <h4>{c.hostTrainTitle}</h4>
    <TypeShadeCode lang="ts" code={hostTraining} title="browser-session.ts — trainBatch" />
    <p>{c.hostTrainExplanation}</p>
    <h4>{c.hostPredictTitle}</h4>
    <TypeShadeCode lang="ts" code={hostPrediction} title="browser-session.ts — predict" />
    <p>{c.hostPredictExplanation}</p>
    <p>{c.boundary}</p>
  </section>
</div>
<style>
  .mnist-walkthrough { max-width: 100%; }
  /* The walkthrough's sentences sit in boxes of their own, which the document's measure does
     not reach, so they take the text measure here. The code frames between them keep the column. */
  .mnist-walkthrough > p, .mnist-step > p, .mnist-host > p { max-inline-size: var(--content); }
  .mnist-flow { border: 1px solid var(--color-line-2); border-radius: var(--radius-md); padding: 12px 16px; margin-block: 18px 22px; }
  .mnist-flow p { margin: 7px 0; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .mnist-flow code { overflow-wrap: anywhere; }
  .mnist-step { margin-block: 32px; }
  .mnist-step h3 { font-size: 1.08rem; margin-bottom: 8px; }
  .mnist-step > p { line-height: 1.65; }
  .mnist-step-explanation { border-inline-start: 3px solid var(--color-line-2); padding-inline-start: 12px; }
  .mnist-host { margin-block: 42px; }
  .mnist-host h3 { margin-bottom: 10px; }
  .mnist-host h4 { margin-top: 24px; }
  .mnist-walkthrough :global(pre) { max-width: 100%; overflow-x: auto; }
  .mnist-walkthrough :global(.expressive-code) { margin-block: 14px; }
</style>
