---
// A type as an entry page of the language reference prints it, with every name the reference
// documents as a link to its own page. This is ApiType.astro for the other reference: the
// token is matched against the names the compiler's own tables carry, so a link only ever
// points at a page that is built. A name both tables hold goes to the type page, since this
// is a type position; the four declarators the ambient file declares as functions and an
// author writes as types (`array`, `storage`) go to their function pages. Text inside quotes
// is a string literal type and is left alone, and the name of the page itself stays plain.
import { languageEntryPath, languageSection } from '../lib/language-reference.ts';
import { localePath, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  /** The type as text, for example 'texture_2d<f32>'. */
  text: string;
  /** The name this page documents, which does not link to itself. */
  self?: string;
}
const { locale, text, self } = Astro.props;

const pages = new Map<string, string>();
for (const entry of languageSection('function').entries) pages.set(entry.name, languageEntryPath('function', entry.name));
for (const entry of languageSection('type').entries) pages.set(entry.name, languageEntryPath('type', entry.name));

// A quoted literal, or an identifier that is not a property after a dot.
const TOKEN = /'[^']*'|"[^"]*"|[A-Za-z_$][A-Za-z0-9_$]*/g;

interface Part {
  readonly text: string;
  readonly href?: string;
}
const parts: Part[] = [];
let at = 0;
for (const m of text.matchAll(TOKEN)) {
  const token = m[0];
  const start = m.index ?? 0;
  const page = token.startsWith("'") || token.startsWith('"') || text[start - 1] === '.' || token === self ? undefined : pages.get(token);
  if (!page) continue;
  if (start > at) parts.push({ text: text.slice(at, start) });
  parts.push({ text: token, href: localePath(locale, page) });
  at = start + token.length;
}
if (at < text.length) parts.push({ text: text.slice(at) });
---

<code class="api-type">{parts.map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}</code>
