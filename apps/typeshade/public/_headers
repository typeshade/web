# Response headers for the static assets the Worker serves (docs/cloudflare.md). Workers reads
# this file and does not serve it. A file whose name carries its content hash never changes
# under that name, so a browser keeps it for a year and does not ask again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
# The fonts keep their names across builds and change only when scripts/build-fonts.py runs.
/fonts/*
  Cache-Control: public, max-age=604800
