{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "./audio.ts",
    "./render.worker.ts",
    "./live.worklet.ts",
    "./live-dsp.ts",
    "./live-audio.ts",
    "../src/**/*.ts",
    "./editor/**/*.ts",
    "./editor/**/*.tsx"
  ],
  "exclude": [
    "./vite.config.ts",
    "../src/**/*.shade.ts",
    "./*.shade.ts"
  ]
}
