---
import Button from '@typeshade/site-ui/astro/Button';
import LinkButton from '@typeshade/site-ui/astro/LinkButton';
import Examples from '../components/Examples';
import '../styles.css';
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>TypeShade UI workbench</title>
  </head>
  <body>
    <main id="main">
      <h1>TypeShade UI workbench</h1>
      <p>Shared controls in their interactive, disabled, loading and error states.</p>
      <section aria-labelledby="astro-heading">
        <h2 id="astro-heading">Astro actions</h2>
        <div class="example-row">
          <Button variant="primary" data-testid="astro-button">Static action</Button>
          <Button disabled>Unavailable static action</Button>
          <LinkButton href="#forms-heading" variant="primary">Open form examples</LinkButton>
        </div>
      </section>
      <Examples client:load />
    </main>
  </body>
</html>
